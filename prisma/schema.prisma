generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Invitation {
  id             String   @id @default(cuid())
  token          String   @unique
  recipientText  String
  guestCount     Int?
  privateMessage String?
  createdAt      DateTime @default(now())
  wishes         WeddingWish[]
  rsvp           Rsvp?
}

model WeddingContent {
  id                      String   @id
  weddingDateTime         DateTime?
  expiredCountdownMessage String?
  venuesJson              Json
  storyChaptersJson       Json
  galleryImagesJson       Json
  albumIntervalMs         Int      @default(5000)
  themePreset             String   @default("light-elegant")
  fontPreset              String   @default("elegant")
  updatedAt               DateTime @updatedAt
}

model WeddingWish {
  id           String   @id @default(cuid())
  invitationId String?
  senderName   String
  message      String
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([isVisible, createdAt])
  @@index([invitationId])
}

model Rsvp {
  id             String   @id @default(cuid())
  invitationId   String   @unique
  attending      Boolean
  confirmedCount Int?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}
