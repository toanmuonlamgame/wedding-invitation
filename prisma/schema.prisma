generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Invitation {
  id             String   @id @default(cuid())
  token          String   @unique
  recipientText  String
  guestCount     Int?
  privateMessage String?
  createdAt      DateTime @default(now())
}
